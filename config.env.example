# ==============================================================================
# TEP CAU HINH BIEN HA TANG CHUAN HOA (INFRASTRUCTURE CONFIGURATION)
# Bo cong cu tu dong hoa trien khai VMware ESXi & vCenter Server Appliance (VCSA)
#
# Huong dan:
#   1. Sao chep tep nay thanh 'config.env': cp config.env.example config.env
#   2. Thay the toan bo cac gia tri trong ngoac nhon <...> bang thong so thuc te
#   3. Tuyet doi khong luu mat khau tai tep nay (mat khau nhap qua terminal an)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THONG TIN MAY CHU ESXI MUC TIEU (TARGET STANDALONE ESXI HOST)
# ------------------------------------------------------------------------------
ESXI_HOSTNAME="<ESXI_HOST_IP>"                  # Dia chi IP hoac FQDN cua may chu ESXi (Vi du: 10.255.245.102)
ESXI_USERNAME="root"                           # Tai khoan quan tri root cua ESXi
ESXI_DATASTORE="<DATASTORE_NAME>"              # Ten kho luu tru Datastore tren ESXi (Vi du: SRV03_Z620_DS)
ESXI_NETWORK="VM Network"                      # Ten Port Group mang may ao ket noi mac dinh

# ------------------------------------------------------------------------------
# 2. CAU HINH NUT MAM DIEU KHIEN (BOOTSTRAP / AUTOMATION SEED NODE)
# ------------------------------------------------------------------------------
UBUNTU_VM_NAME="UBUNTU-AUTOMATION"             # Ten may ao Ubuntu dieu khien tren ESXi Inventory
UBUNTU_OVA_PATH="<PATH_TO_UBUNTU_CLOUD_OVA>"   # Duong dan tep Ubuntu Cloud OVA (Vi du: /mnt/e/ubuntu-22.04-server-cloudimg-amd64.ova)
UBUNTU_VM_USER="ubuntu"                        # Ten tai khoan dang nhap mac dinh cua may ao
UBUNTU_STATIC_IP="<UBUNTU_AUTOMATION_IP>"      # Dia chi IP tinh cua may ao Ubuntu (Vi du: 10.255.245.105)
UBUNTU_PREFIX="24"                             # Subnet mask dang CIDR (Mac dinh: 24 tuong ung 255.255.255.0)
UBUNTU_GATEWAY="<GATEWAY_IP>"                  # Cong ket noi mac dinh (Default Gateway) (Vi du: 10.255.245.1)
UBUNTU_DNS_UPSTREAM="<UPSTREAM_DNS_IP>"        # May chu DNS ha tang chuyen tiep ra ngoai (Vi du: 10.255.242.1)

# ------------------------------------------------------------------------------
# 3. CAU HINH MAY AO VCENTER SERVER APPLIANCE (VCSA)
# ------------------------------------------------------------------------------
VCSA_VM_NAME="VCSA-01"                         # Ten may ao vCenter tren ESXi Inventory
VCSA_SIZE="tiny"                               # Quy mo may ao: tiny (14GB RAM), small (19GB RAM), medium (28GB RAM)
VCSA_STATIC_IP="<VCSA_STATIC_IP>"              # Dia chi IP tinh cho VCSA (Vi du: 10.255.245.106)
VCSA_PREFIX="24"                               # Subnet mask CIDR cua VCSA
VCSA_GATEWAY="<GATEWAY_IP>"                    # Default Gateway cua VCSA (Vi du: 10.255.245.1)
VCSA_FQDN="<VCSA_FQDN>"                        # Ten mien dinh danh he thong FQDN (Vi du: vcsa.int)
VCSA_ISO_PATH="<PATH_TO_VCSA_ISO>"             # Duong dan tep ISO cai dat VCSA (Vi du: /mnt/e/VMware-VCSA-all-8.0.3-24322831.iso)

# ------------------------------------------------------------------------------
# 4. THONG SO HE DIEU HANH VA SINGLE SIGN-ON (SSO) VSPHERE
# ------------------------------------------------------------------------------
NTP_SERVERS="pool.ntp.org"                     # Danh sach may chu NTP dong bo thoi gian
SSO_DOMAIN_NAME="vsphere.local"                 # Ten mien dinh danh Single Sign-On vSphere
